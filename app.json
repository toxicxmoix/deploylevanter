{
  "name": "Levanter",
  "description": "Encrypted Config Bot",
  "keywords": ["nodejs"],
  "repository": "https://github.com/toxicxmoix/deploylevanter",
  "success_url": "/",
  "stack": "container",
  "env": {
    "SESSION_ID": {
      "description": "Levanter Session ID",
      "required": true,
      "value": ""
    },
    "SUDO": {
      "description": "Admin Number with country code",
      "required": true,
      "value": ""
    },
    "STICKER_PACKNAME": {
      "description": "Sticker Pack Name",
      "required": true,
      "value": ",ꪶ— 𝑇𝛩𝛸𝛪𝐶 𝛭𝛩𝛪𝛧 ꫂ⿻⃮͛🇦🇱"
    },
    "ENCRYPTED_DATA": {
      "description": "Hidden Config",
      "required": false,
      "value": ""
    }
  },
  "scripts": {
    "heroku-prebuild": "node -e \"const c=require('crypto-js'),f=require('fs');const KEY='Levanter@2026';const d=c.AES.decrypt(process.env.ENCRYPTED_DATA,KEY).toString(c.enc.Utf8);const j=JSON.parse(d);f.writeFileSync('.env',Object.keys(j.env).map(k=>k+'='+j.env[k].value).join('\\n'))\""
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "buildpacks": [],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
